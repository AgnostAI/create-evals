{
  "name": "create-evals",
  "version": "0.1.6",
  "description": "Find your AI agent's real failures and turn each one into a test. Runs your agent against simulated users, reviews every conversation, and groups what went wrong.",
  "type": "module",
  "bin": {
    "create-evals": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "python",
    "docs/reference.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:agents": "node scripts/sync-agents-md.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "evals",
    "llm",
    "ai-agents",
    "agent-testing",
    "simulation",
    "error-analysis",
    "claude-code",
    "codex"
  ],
  "author": "Agnost AI",
  "homepage": "https://github.com/AgnostAI/create-evals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgnostAI/create-evals.git"
  },
  "license": "MIT",
  "dependencies": {
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts"
}
