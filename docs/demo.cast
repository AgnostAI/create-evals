[4.002,"o","\u001b[?25h\u001b[90m│\u001b[39m\r\n"]
[4.032,"o","\u001b[32m◇\u001b[39m  \u001b[0mHow this works\u001b[0m \u001b[90m───────────────────────────────────────────────────────────╮\u001b[39m\r\n"]
[4.062,"o","\u001b[90m│\u001b[39m                                                                            \u001b[90m│\u001b[39m\r\n"]
[4.092,"o","\u001b[90m│\u001b[39m  Answer \u001b[1myes\u001b[22m if the agent is allowed to do it, \u001b[1mno\u001b[22m if it needs a guardrail.  \u001b[90m│\u001b[39m\r\n"]
[4.122,"o","\u001b[90m│\u001b[39m  Each answer becomes one eval.                                             \u001b[90m│\u001b[39m\r\n"]
[4.152,"o","\u001b[90m│\u001b[39m                                                                            \u001b[90m│\u001b[39m\r\n"]
