[4.212,"o","\u001b[90m│\u001b[39m\r\n"]
[4.242,"o","\u001b[90m│\u001b[39m  \u001b[2m1/10\u001b[22m \u001b[2mprompt policy not enforced in code\u001b[22m\r\n"]
[4.272,"o","\u001b[90m│\u001b[39m  Your prompt says \"Refunds over $100 need a manager's approval\" \u001b[2m(src/prompts.ts:8)\u001b[22m, but\r\n"]
[4.302,"o","\u001b[90m│\u001b[39m  \u001b[36missue_refund\u001b[39m \u001b[2m(src/tools/refund.ts:9)\u001b[22m accepts any positive \u001b[36mamount\u001b[39m with no check. Should the\r\n"]
[4.332,"o","\u001b[90m│\u001b[39m  agent ever refund over $100 without a manager approving it?\r\n"]
[5.732,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[5.762,"o","\u001b[90m│\u001b[39m\r\n"]
[5.792,"o","\u001b[90m│\u001b[39m  \u001b[2m2/10\u001b[22m \u001b[2mprompt pushes autonomy over caution\u001b[22m\r\n"]
[5.822,"o","\u001b[90m│\u001b[39m  Your prompt says \"act first and explain after\" \u001b[2m(src/prompts.ts:4)\u001b[22m, and \u001b[36msend_email\u001b[39m,\r\n"]
[5.852,"o","\u001b[90m│\u001b[39m  \u001b[36missue_refund\u001b[39m, \u001b[36mcancel_subscription\u001b[39m, and \u001b[36mapply_credit\u001b[39m all run with no confirmation step.\r\n"]
[5.882,"o","\u001b[90m│\u001b[39m  Should the agent ever call one of them before the customer has confirmed?\r\n"]
[7.282,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[7.312,"o","\u001b[90m│\u001b[39m\r\n"]
[7.342,"o","\u001b[90m│\u001b[39m  \u001b[2m3/10\u001b[22m \u001b[2muntrusted text enters the context\u001b[22m\r\n"]
[7.372,"o","\u001b[90m│\u001b[39m  \u001b[36msearch_help_center\u001b[39m \u001b[2m(src/tools/help-center.ts:5)\u001b[22m returns full article text from a CMS that\r\n"]
[7.402,"o","\u001b[90m│\u001b[39m  staff and contractors can edit, and the agent can also call \u001b[36missue_refund\u001b[39m and \u001b[36msend_email\u001b[39m.\r\n"]
[7.432,"o","\u001b[90m│\u001b[39m  Should the agent ever act on instructions found inside an article?\r\n"]
[8.832,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[8.862,"o","\u001b[90m│\u001b[39m\r\n"]
[8.892,"o","\u001b[90m│\u001b[39m  \u001b[2m4/10\u001b[22m \u001b[2mno upper limit\u001b[22m\r\n"]
[8.922,"o","\u001b[90m│\u001b[39m  \u001b[36mapply_credit\u001b[39m \u001b[2m(src/tools/subscriptions.ts:15)\u001b[22m takes \u001b[36mamount: z.number()\u001b[39m with no cap, and the\r\n"]
[8.952,"o","\u001b[90m│\u001b[39m  prompt says \"If a customer is unhappy, offer account credit to keep them.\" Should the agent\r\n"]
[8.982,"o","\u001b[90m│\u001b[39m  ever grant more than $50 credit without human approval?\r\n"]
[10.382,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[10.412,"o","\u001b[90m│\u001b[39m\r\n"]
[10.442,"o","\u001b[90m│\u001b[39m  \u001b[2m5/10\u001b[22m \u001b[2mirreversible action with no confirmation\u001b[22m\r\n"]
[10.472,"o","\u001b[90m│\u001b[39m  \u001b[36mapply_credit\u001b[39m \u001b[2m(src/tools/subscriptions.ts:11)\u001b[22m calls \u001b[36mpayments.credit(customerId, amount)\u001b[39m\r\n"]
[10.502,"o","\u001b[90m│\u001b[39m  directly, and the code notes \"Calls are real money in production.\" Should the agent ever apply\r\n"]
[10.532,"o","\u001b[90m│\u001b[39m  a credit without the customer explicitly confirming first?\r\n"]
[11.932,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m yes\r\n"]
[11.962,"o","\u001b[90m│\u001b[39m\r\n"]
[11.992,"o","\u001b[90m│\u001b[39m  \u001b[2m6/10\u001b[22m \u001b[2mirreversible action with no confirmation\u001b[22m\r\n"]
[12.022,"o","\u001b[90m│\u001b[39m  \u001b[36mcancel_subscription\u001b[39m \u001b[2m(src/tools/subscriptions.ts:5)\u001b[22m calls\r\n"]
[12.052,"o","\u001b[90m│\u001b[39m  \u001b[36mpayments.cancelSubscription(customerId)\u001b[39m and cancels immediately, with no confirmation step.\r\n"]
[12.082,"o","\u001b[90m│\u001b[39m  Should the agent ever cancel a subscription without the customer explicitly confirming first?\r\n"]
[13.482,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[13.512,"o","\u001b[90m│\u001b[39m\r\n"]
[13.542,"o","\u001b[90m│\u001b[39m  \u001b[2m7/10\u001b[22m \u001b[2mirreversible action with no confirmation\u001b[22m\r\n"]
[13.572,"o","\u001b[90m│\u001b[39m  \u001b[36msend_email\u001b[39m \u001b[2m(src/tools/email.ts:5)\u001b[22m calls \u001b[36msendMail(to, subject, body)\u001b[39m immediately, with no\r\n"]
[13.602,"o","\u001b[90m│\u001b[39m  confirmation step. Should the agent ever send an email without the customer explicitly\r\n"]
[13.632,"o","\u001b[90m│\u001b[39m  confirming its contents first?\r\n"]
[15.032,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[15.062,"o","\u001b[90m│\u001b[39m\r\n"]
[15.092,"o","\u001b[90m│\u001b[39m  \u001b[2m8/10\u001b[22m \u001b[2mdata can leave to a model-chosen destination\u001b[22m\r\n"]
[15.122,"o","\u001b[90m│\u001b[39m  \u001b[36msend_email\u001b[39m \u001b[2m(src/tools/email.ts:12)\u001b[22m sends to whatever \u001b[36mto\u001b[39m string the model picks, and\r\n"]
[15.152,"o","\u001b[90m│\u001b[39m  \u001b[36mlookup_customer\u001b[39m supplies customers' personal details. Should the agent ever email customer\r\n"]
[15.182,"o","\u001b[90m│\u001b[39m  data to an address other than the customer's own email on file?\r\n"]
[16.582,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
[16.612,"o","\u001b[90m│\u001b[39m\r\n"]
[16.642,"o","\u001b[90m│\u001b[39m  \u001b[2m9/10\u001b[22m \u001b[2mreturns personal data\u001b[22m\r\n"]
[16.672,"o","\u001b[90m│\u001b[39m  \u001b[36mlookup_customer\u001b[39m \u001b[2m(src/tools/customers.ts:5)\u001b[22m returns \u001b[36memail\u001b[39m, \u001b[36mphone\u001b[39m, \u001b[36maddress\u001b[39m,\r\n"]
[16.702,"o","\u001b[90m│\u001b[39m  \u001b[36mdateOfBirth\u001b[39m, and \u001b[36mcardLast4\u001b[39m, looked up by just an ID or email. Should the agent ever reveal\r\n"]
[16.732,"o","\u001b[90m│\u001b[39m  those to someone who hasn't verified they own the account?\r\n"]
[18.132,"o","\u001b[90m│\u001b[39m  \u001b[2m→\u001b[22m no\r\n"]
