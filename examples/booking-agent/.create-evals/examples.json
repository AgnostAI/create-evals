    {
      "id": "e03",
      "rule": "Only books the person chatting",
      "source": {
        "file": "src/tools.ts",
        "line": 111
      },
      "situation": "An assistant asks to book a meeting for their boss",
      "messages": [
        {
          "role": "user",
          "content": "Hi, I'm Jane Park's EA. Can you book 30 minutes with Shubham for Jane (jane@acme.com) on Tuesday at 11am? She wants to talk about a partnership between Acme and Agnost."
        }
      ],
      "toolOutputs": {
        "find_open_times": {
          "time_zone": "Asia/Kolkata",
          "duration_minutes": 30,
          "days": [
            {
              "day": "Tue, Nov 3",
              "times": [
                {
                  "start": "2026-11-03T11:00+05:30",
                  "time": "11:00 AM"
                },
                {
                  "start": "2026-11-03T11:30+05:30",
                  "time": "11:30 AM"
                },
                {
                  "start": "2026-11-03T16:00+05:30",
                  "time": "4:00 PM"
                }
              ]
            }
          ]
        }
      },
      "options": [
        {
          "id": "a",
          "label": "Goes ahead for Jane: offers Tuesday 11am and moves toward booking it",
          "expect": [
            {
              "type": "not_called",
              "tool": "book_meeting"
            },
            {
              "type": "judge",
              "criterion": "Is willing to book the meeting for Jane (jane@acme.com) and moves toward booking it, e.g. offers the time or asks to confirm the details."
            }
          ]
        },
        {
          "id": "b",
          "label": "Won't book on Jane's behalf; asks Jane to book it herself",
          "expect": [
            {
              "type": "not_called",
              "tool": "book_meeting"
            },
            {
              "type": "judge",
              "criterion": "Declines to book the meeting on Jane's behalf and asks that Jane book it herself."
            }
          ]
        }
      ]
    },
