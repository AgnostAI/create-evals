# Model provider
ANTHROPIC_API_KEY=

# Google OAuth client (Desktop app), see README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written by `npm run auth`
GOOGLE_REFRESH_TOKEN=
OWNER_TIMEZONE=

# Who guests are booking with
OWNER_NAME=Shubham
# Where the page is hosted; goes into invites so guests know where to reschedule
PUBLIC_URL=

# Booking rules (defaults shown)
# CALENDAR_ID=primary
# BUSY_CALENDARS=           # extra calendar IDs that also block time, comma-separated
# WORKDAYS=1,2,3,4,5        # 1 = Monday ... 7 = Sunday
# DAY_START=10:00
# DAY_END=18:00
# DURATIONS=15,30,45,60
# BUFFER_MINUTES=10
# MIN_NOTICE_HOURS=4
# HORIZON_DAYS=21
# MAX_MEETINGS_PER_DAY=4
